{
  "name": "glyph",
  "private": true,
  "version": "1.6.0",
  "type": "module",
  "description": "Glyph: a mobile-first markdown notes app built on Glacier UI.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p mcp --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "check": "npm run lint && npm run typecheck && npm run test",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build --bundles app,dmg",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "ios:dev": "node scripts/ios-clean.mjs && tauri ios dev",
    "ios:build": "node scripts/ios-clean.mjs && tauri ios build",
    "ios:build:sim": "node scripts/ios-clean.mjs && tauri ios build --debug --target aarch64-sim",
    "android:dev": "JAVA_HOME=\"/opt/homebrew/opt/openjdk@17/libexec/openjdk.jdk/Contents/Home\" ANDROID_HOME=\"$HOME/Library/Android/sdk\" NDK_HOME=\"$HOME/Library/Android/sdk/ndk/26.3.11579264\" tauri android dev",
    "android:build": "JAVA_HOME=\"/opt/homebrew/opt/openjdk@17/libexec/openjdk.jdk/Contents/Home\" ANDROID_HOME=\"$HOME/Library/Android/sdk\" NDK_HOME=\"$HOME/Library/Android/sdk/ndk/26.3.11579264\" tauri android build",
    "push:fold": "node scripts/push-fold.mjs",
    "fetch:model": "node scripts/fetch-model.mjs",
    "voice:text": "node scripts/voice-suite-text.mjs",
    "voice:hear": "cd src-tauri && cargo test --release --lib whisper::suite -- --ignored --nocapture",
    "voice:check": "GLYPH_VOICE=1 vitest run src/app/capture/voiceSuite",
    "voice:suite": "npm run voice:hear && npm run voice:check",
    "deploy:ota": "node scripts/deploy-ota.mjs",
    "deploy:server": "node scripts/deploy-server.mjs",
    "mcp:build": "node scripts/build-mcp.mjs",
    "mcp": "node scripts/build-mcp.mjs && node mcp/dist/glyph-mcp.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@glacier/icons": "file:./vendor/@glacier/icons",
    "@glacier/react": "file:./vendor/@glacier/react",
    "@glacier/tokens": "file:./vendor/@glacier/tokens",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-haptics": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2",
    "express": "^5.2.1",
    "lucide-react": "^1.23.0",
    "mermaid": "^12.0.0",
    "motion": "^12.23.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "y-codemirror.next": "^0.3.6",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.32",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "26.2.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.0"
  }
}
