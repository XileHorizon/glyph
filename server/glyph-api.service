# glyph-api: annotates Glyph voice notes for attack.fm/glyph/api/*.
#
# Installed by scripts/deploy-server.mjs, which rewrites this file on every
# deploy - edit it here, not on the box.
#
# Shaped like attackfm.service on the same box on purpose: a dedicated system
# user, loopback only (Caddy is the one door), and the same hardening lines.
# It needs less than AttackFM does - no music - and writes only to its state
# directory, which ProtectSystem=strict leaves writable because systemd made it.

[Unit]
Description=Glyph API (voice note annotation via the local Ollama)
After=network-online.target ollama.service
Wants=network-online.target

[Service]
# GLYPH_API_TOKEN lives here, root-owned 0600. systemd reads it as root before
# dropping to the service user, so the user itself cannot read the file.
EnvironmentFile=/opt/glyph-api/glyph-api.env
Environment=GLYPH_API_BIND=127.0.0.1:8796
Environment=OLLAMA_URL=http://127.0.0.1:11434
# Accounts and end-to-end encrypted sync (docs/SYNC.md): the database, its signing key and the recordings live in
# /var/lib/glyph-api, which systemd makes and gives to the service user. It is the one place the service writes,
# and the one thing on the box that needs backing up - the signing key is inside it.
StateDirectory=glyph-api
StateDirectoryMode=0700
Environment=GLYPH_API_DATA=/var/lib/glyph-api
ExecStart=/opt/glyph-api/bin/glyph-api
User=glyph
Group=glyph
Restart=on-failure
RestartSec=2
# An in-flight annotation is allowed to finish on stop: 45 s is the upstream
# ceiling, and five more is the margin.
TimeoutStopSec=50

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
# Measured idle on the box: 4.2 MB resident, 1.4 MB charged to the unit's
# cgroup. A recording is held whole while it is stored (64 MB at most), so the
# ceiling leaves room for one of those and the rest; it is still for a bug,
# not for the workload.
MemoryMax=256M

[Install]
WantedBy=multi-user.target
