{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ghost.md",
  "version": "1.6.0",
  "identifier": "com.mattssoftware.glyph",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5250",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Ghost.md",
        "label": "main",
        "width": 1280,
        "height": 820,
        "minWidth": 360,
        "minHeight": 560,
        "center": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": false,
        "resizable": true,
        "backgroundThrottling": "disabled"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "iOS": {
      "minimumSystemVersion": "15.0",
      "developmentTeam": "F6ZAL7ANAD"
    },
    "macOS": {
      "entitlements": "Entitlements.plist",
      "infoPlist": "Info.macos.plist",
      "hardenedRuntime": true,
      "minimumSystemVersion": "13.1"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
