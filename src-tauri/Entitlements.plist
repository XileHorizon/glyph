<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  What the signed Mac app may do under the hardened runtime (tauri.conf.json bundle.macOS.entitlements). A Developer ID
  build runs hardened, and hardened means the microphone is closed until this says otherwise: without it the permission
  prompt never appears and getUserMedia hands back silence, with no error to say why. The app is not sandboxed, so the
  network needs no entitlement of its own.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
